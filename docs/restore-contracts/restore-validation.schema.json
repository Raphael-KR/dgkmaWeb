{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dgkma.org/schemas/dgkma-restore-validation-v1.json",
  "title": "DGKMA restore validation receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_target_fingerprint",
    "disposable_target_fingerprint",
    "restore_run_uid",
    "source_server_version_num",
    "pg_dump_version",
    "pg_restore_version",
    "source_snapshot_observed_at",
    "source_snapshot_id_sha256",
    "source_txid_snapshot",
    "source_snapshot_started_at",
    "source_snapshot_finished_at",
    "source_current_wal_lsn",
    "dump_started_at",
    "dump_finished_at",
    "dump_duration_ms",
    "restore_started_at",
    "restore_finished_at",
    "restore_duration_ms",
    "dump_sha256",
    "source_manifest_sha256",
    "sequence_60_artifact_id",
    "sequence_60_artifact_sha256",
    "restore_reconcile_sha256",
    "pre_security_catalog_sha256",
    "post_security_catalog_sha256",
    "schema_catalog_sha256",
    "data_catalog_sha256",
    "observed_at",
    "result",
    "receipt_sha256"
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "uuid_v4": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "instant": { "type": "string", "format": "date-time" },
    "duration": { "type": "integer", "minimum": 0 }
  },
  "properties": {
    "schema_version": { "const": "dgkma-restore-validation-v1" },
    "source_target_fingerprint": { "$ref": "#/$defs/sha256" },
    "disposable_target_fingerprint": { "$ref": "#/$defs/sha256" },
    "restore_run_uid": { "$ref": "#/$defs/uuid_v4" },
    "source_server_version_num": { "type": "integer", "minimum": 150000 },
    "pg_dump_version": { "type": "string", "pattern": "^pg_dump \\(PostgreSQL\\) [0-9]+(?:\\.[0-9]+)+$" },
    "pg_restore_version": { "type": "string", "pattern": "^pg_restore \\(PostgreSQL\\) [0-9]+(?:\\.[0-9]+)+$" },
    "source_snapshot_observed_at": { "$ref": "#/$defs/instant" },
    "source_snapshot_id_sha256": { "$ref": "#/$defs/sha256" },
    "source_txid_snapshot": { "type": "string", "pattern": "^[0-9]+:[0-9]+:(?:[0-9]+(?:,[0-9]+)*)?$" },
    "source_snapshot_started_at": { "$ref": "#/$defs/instant" },
    "source_snapshot_finished_at": { "$ref": "#/$defs/instant" },
    "source_current_wal_lsn": { "type": "string", "pattern": "^[0-9a-f]+/[0-9a-f]+$" },
    "dump_started_at": { "$ref": "#/$defs/instant" },
    "dump_finished_at": { "$ref": "#/$defs/instant" },
    "dump_duration_ms": { "$ref": "#/$defs/duration" },
    "restore_started_at": { "$ref": "#/$defs/instant" },
    "restore_finished_at": { "$ref": "#/$defs/instant" },
    "restore_duration_ms": { "$ref": "#/$defs/duration" },
    "dump_sha256": { "$ref": "#/$defs/sha256" },
    "source_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "sequence_60_artifact_id": { "const": "database-security-v1" },
    "sequence_60_artifact_sha256": { "$ref": "#/$defs/sha256" },
    "restore_reconcile_sha256": { "$ref": "#/$defs/sha256" },
    "pre_security_catalog_sha256": { "$ref": "#/$defs/sha256" },
    "post_security_catalog_sha256": { "$ref": "#/$defs/sha256" },
    "schema_catalog_sha256": { "$ref": "#/$defs/sha256" },
    "data_catalog_sha256": { "$ref": "#/$defs/sha256" },
    "observed_at": { "$ref": "#/$defs/instant" },
    "result": { "enum": ["verified", "rejected"] },
    "receipt_sha256": { "$ref": "#/$defs/sha256" }
  }
}

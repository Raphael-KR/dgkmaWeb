    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tanstack/react-query": "^5.60.5",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-bubble-menu": "3.33.0",
    "@tiptap/markdown": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "@tiptap/static-renderer": "3.33.0",
    "@types/pg": "^8.15.5",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "connect-pg-simple": "^10.0.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.0",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "googleapis": "^153.0.0",
    "htmlparser2": "^10.1.0",
    "korean-lunar-calendar": "^0.4.0",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.1.16",
    "pg": "^8.16.3",
    "playwright-core": "1.65.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.55.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "7.0.0",
    "wouter": "^3.3.5",
    "ws": "^8.21.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@replit/vite-plugin-cartographer": "^0.5.5",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.3",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "postcss": "^8.5.28",
    "prettier": "3.9.10",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "5.6.3",
    "typescript-eslint": "8.72.1",
    "vite": "^6.4.3"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@babel/helpers": "7.29.7",

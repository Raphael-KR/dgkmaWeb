{
  "name": "rest-express",
  "version": "2.0.2",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "test": "node scripts/run-tests.mjs",
    "test:development-db": "RUN_DEVELOPMENT_DB_TESTS=1 node --import tsx --test --test-concurrency=1 server/modules/events/event-parse-limiter.test.ts server/modules/identity/account-deletion-storage.test.ts server/modules/identity/kakao-oauth-state.test.ts server/modules/identity/kakao-termination-race.test.ts server/modules/registry/alumni-sync-storage.test.ts server/modules/registry/member-registration-concurrency.test.ts server/modules/registry/pending-registration-approval-race.test.ts server/modules/registry/pending-registration-concurrency.test.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc && npm run check:boundaries",
    "check:tests": "tsc -p tsconfig.tests.json",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:route-recovery-browser": "node --import tsx scripts/test-route-recovery-browser.mjs",
    "db:push": "drizzle-kit push",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{client,server,shared,scripts,artifacts/mockup-sandbox}/**/*.{js,mjs,ts,tsx,css}\" \"*.{ts,mjs,js}\"",
    "format:check": "prettier --check \"{client,server,shared,scripts,artifacts/mockup-sandbox}/**/*.{js,mjs,ts,tsx,css}\" \"*.{ts,mjs,js}\""
  },
  "dependencies": {

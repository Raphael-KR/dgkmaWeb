# 카카오 로그인 설정

# Replit 내장 PostgreSQL (PG* 환경변수 자동 주입)
# Replit 환경에서는 PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE 가 자동으로 주입됩니다.
# 별도 DATABASE_URL 설정 없이 Drizzle이 PG* 변수로 직접 접속합니다.
# 로컬 개발 시에만 필요한 경우 아래에 직접 설정하세요.
# DATABASE_URL=postgresql://user:password@host:port/database

# 구글 시트 API (동문 데이터 연동용)
GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key_here
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Sheets API credentials (service account)
GOOGLE_SHEETS_PRIVATE_KEY=""
GOOGLE_SHEETS_CLIENT_EMAIL=""
GOOGLE_SHEETS_SPREADSHEET_ID=""

# 카카오톡 메시지 API (알림용)
KAKAO_ADMIN_KEY=your_kakao_admin_key_here

# Kakao Login (server-side, v5 REST authorize 흐름)
#
# 브라우저는 /api/auth/kakao/start 로 로그인을 시작하고, 서버만 아래 설정을 선택합니다.
# REPLIT_DEPLOYMENT 가 정확히 "1"이면 Production, 그 외에는 Development 설정을 사용합니다.
# 각 Redirect URI는 카카오 디벨로퍼스 콘솔에 byte-for-byte 동일하게 등록해야 합니다.
# 개발과 운영의 REST API 키와 클라이언트 시크릿에는 각각 별도 값을 넣으세요.
#
# Development (Kakao TEST 앱)
KAKAO_DEV_REST_API_KEY="your_development_kakao_rest_api_key"
KAKAO_DEV_CLIENT_SECRET="your_development_kakao_client_secret"
KAKAO_DEV_REDIRECT_URI="https://dc5e5541-525b-4ad6-b914-2d2db70cb4a9-00-flpzugprplfl.spock.replit.dev/kakao-callback"

# Production (Kakao business 앱)
KAKAO_PROD_REST_API_KEY="your_production_kakao_rest_api_key"
KAKAO_PROD_CLIENT_SECRET="your_production_kakao_client_secret"
KAKAO_PROD_REDIRECT_URI="https://dgkma.org/kakao-callback"

# JWT 비밀키
JWT_SECRET=your_jwt_secret_key_here

# 개발 환경 설정
NODE_ENV=development

# (선택) 카카오 로그인 디버그 로그. 운영에서는 기본 OFF.
# true이면 토큰 교환 전에 [Kakao OAuth] configuration 로그가 출력됩니다.
# 로그에는 선택된 environment, 앞 6자리만 마스킹한 restApiKeyPrefix,
# redirectUri, hasClientSecret(boolean)만 포함하며 키·시크릿·토큰 원문은 출력하지 않습니다.
DEBUG_KAKAO_AUTH=""

# Replit Secrets 변수명 참고. 실제 값은 저장소·Mac .env에 복사하지 않습니다.
# 환경과 선택 규칙: replit.md / 시작 절차: docs/runbooks/development.md
# 아래는 빈 예시이며 이 파일만으로 앱·DB·외부 연동이 설정되지는 않습니다.

# 앱의 server/db.ts는 Replit PG*를 DATABASE_URL보다 우선합니다.
# PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE는 Replit 주입값을 사용합니다.
# Drizzle CLI는 DATABASE_URL을 직접 사용하므로 앱과 대상이 같다고 가정하지 않습니다.
# 운영 DB URL은 이 파일에 두지 않습니다.
DATABASE_URL=""
SESSION_SECRET=""

# 동문 명부: Google Sheets 관리 원본 / PostgreSQL 런타임 복제본
ALUMNI_SPREADSHEET_ID=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""

# Kakao v5 REST OAuth. REPLIT_DEPLOYMENT="1"일 때만 Production 설정을 선택합니다.
# 개발·운영 키/시크릿은 구분하고 callback은 Kakao 설정과 정확히 일치해야 합니다.
# ADMIN_USER_IDS는 양의 숫자 회원번호의 쉼표 구분 목록이며 서버에서만 사용합니다.
KAKAO_DEV_REST_API_KEY=""
KAKAO_DEV_CLIENT_SECRET=""
KAKAO_DEV_REDIRECT_URI="https://dc5e5541-525b-4ad6-b914-2d2db70cb4a9-00-flpzugprplfl.spock.replit.dev/kakao-callback"
KAKAO_DEV_ADMIN_KEY=""
KAKAO_DEV_ADMIN_USER_IDS=""

KAKAO_PROD_REST_API_KEY=""
KAKAO_PROD_CLIENT_SECRET=""
KAKAO_PROD_REDIRECT_URI="https://dgkma.org/kakao-callback"
KAKAO_PROD_ADMIN_KEY=""
KAKAO_PROD_ADMIN_USER_IDS=""

# 권리회원 단톡방: 제공된 초대 주소는 Replit Secrets에만 설정합니다.
# 공개 채널 VITE_KAKAO_CHANNEL_URL과 별개이며 브라우저 번들에 넣지 않습니다.
KAKAO_RIGHTS_GROUP_INVITE_URL=""

# 경조사 생성: 서버 Responses API. 키를 VITE_ 변수에 넣지 않습니다.
OPENAI_API_KEY=""
# 선택: OPENAI_NOTICE_MODEL 미설정 시 코드 기본값 사용(replit.md 참조).
# OPENAI_NOTICE_MODEL=""
# 선택: 자동 탐색 대신 설치된 Chromium 경로를 지정할 때만 설정.
# COLLECTOR_CHROMIUM_PATH=""

# 기존 첨부 파일 Object Storage
PRIVATE_OBJECT_DIR=""

# 선택: 공개 canonical/SEO 기준 주소. 회원 비밀정보가 아닌 공개 URL입니다.
APP_URL="https://dgkma.org"
# 선택: VITE_KAKAO_CHANNEL_URL=""
# 선택: DEBUG_KAKAO_AUTH="" (운영 기본 OFF; 키·토큰·인가 코드 원문 출력 금지)
# NODE_ENV는 npm dev/start 명령이 설정하고 REPLIT_DEPLOYMENT는 Replit이 주입합니다.
